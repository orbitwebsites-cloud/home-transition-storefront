# Copy to .env.local and fill in real values. NEVER commit real keys.
# The CTA calls /api/checkout, which reads these. Without STRIPE_SECRET_KEY,
# the checkout route returns a clear "not configured" response (501) and the
# UI shows a message instead of charging anyone.

# Required to enable real Stripe Checkout (server-side):
STRIPE_SECRET_KEY=

# Publishable (client) key. The current flow redirects to Stripe-hosted
# Checkout via the session URL, so this is NOT consumed in the browser yet —
# it's here for when you add Stripe.js / Elements client-side. NOTE: to read it
# in the browser, Next.js requires the NEXT_PUBLIC_ prefix
# (e.g. NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY). Set both if you go that route.
STRIPE_PUBLISHABLE_KEY=

# Optional: use a pre-created Stripe Price instead of inline $49 price_data:
# STRIPE_PRICE_ID=price_xxx

# Absolute base URL used for Stripe success/cancel redirects.
# In local dev this defaults to the request origin if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for the Stripe webhook (/api/webhooks/stripe) to verify event
# signatures. From Stripe Dashboard → Developers → Webhooks (add an endpoint
# for your deployed URL), or from `stripe listen` during local testing.
STRIPE_WEBHOOK_SECRET=
